# ===========================================================================
# Multilingual file for the TOS 7 Docker application "labelstudiodocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "label-studio"
auth         = "HumanSignal"
version      = "@@VERSION@@"
descript     = "Label Studio is a multi-type data labeling and annotation tool with standardized output format. Packaged for TerraMaster TOS 7: the official Docker Hub image runs as a container on your NAS, keeps its data in the application data folder (so it survives restarts and updates), and is opened from its desktop icon."
release_note = "1. First release."
important    = "First run: open the web UI and complete the initial setup. Data lives in /Volume1/DockerAppData/labelstudiodocker/ and survives restarts and updates. The container runs as uid 1000, so mounted folders must be readable by that user. Needs DockerEngine; configure a registry mirror if Docker Hub is unreachable. Back up the application data folder before uninstalling with data removal. Plain HTTP on the LAN."

[zh-cn]
name         = "label-studio"
auth         = "HumanSignal"
version      = "@@VERSION@@"
descript     = "数据标注平台，支持文本、图像、音频标注。"
release_note = "1. First release."
important    = "首次使用请打开网页完成初始化。数据保存在 DockerAppData/labelstudiodocker，重启和升级不会丢失。容器以 uid 1000 运行，挂载目录需对该用户可读。需要 DockerEngine；Docker Hub 不可达时先配置镜像加速。卸载并删除数据前请备份。局域网内为 HTTP。"

